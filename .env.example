# Copie para .env e troque TODOS os valores.  Gere segredos com:  openssl rand -base64 36
DB_SENHA=troque-esta-senha-do-banco
SESSION_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
CRON_SECRET=troque-este-segredo-do-agendador
BACKUP_SENHA=senha-para-criptografar-os-backups-GUARDE-FORA-DO-MINI-PC

# Primeiro acesso (só usado se ainda não houver nenhum usuário)
ADMIN_LOGIN=admin
ADMIN_SENHA=troque123

# Nome pelo qual os aparelhos acessam o mini-PC (configure no roteador ou use o IP)
ENDERECO_LOJA=estoque.local

# Backup na nuvem (opcional, recomendado). Ex.: "b2:minha-bucket/distribuidora" ou "gdrive:Backups/distribuidora"
# Configure o remoto com:  docker compose run --rm rotinas rclone config --config /config/rclone/rclone.conf
RCLONE_DESTINO=
PASTA_BACKUP=./backups

# Notificação de validade (opcional): URL que recebe POST {texto, itens}. Ex.: n8n, serviço de WhatsApp.
WEBHOOK_ALERTAS=
FAIXAS_VALIDADE=15,30,60,90

# Leitura de nota com IA (opcional): PDF/foto do DANFE ou pedido em texto, quando o fornecedor não manda o XML.
# Crie a chave em console.anthropic.com. Sem chave, o botão "Ler com IA" avisa que não está configurado.
ANTHROPIC_API_KEY=
# Modelo usado na leitura (padrão: claude-haiku-5-5, rápido e barato)
IA_MODELO=

# Desenvolvimento local (sem HTTPS): COOKIE_SECURE=false
